set ignoreTypes = false.

type pubKey.
type secKey.
type key.
type seq.

table ueDB(bitstring, key, bitstring).

free sch:   channel [private].
free usch:  channel.

const AMF: bitstring.
const SNname: bitstring.

fun fP_k1(key): key.
fun fP_k2(key): key.
fun sha256(bitstring): bitstring.
fun calc_sqn(bitstring, pubKey, pubKey): bitstring.
fun pk(secKey): pubKey.
fun sk(pubKey): secKey.
fun hmac(key, bitstring): bitstring.

fun f1(bitstring, bitstring, bitstring): bitstring.
fun f2(bitstring): bitstring.
fun f3(bitstring): bitstring.
fun f4(bitstring): bitstring.
fun f5(bitstring): bitstring.

fun k2b(key):           bitstring[data, typeConverter].
fun b2k(bitstring):     key[data, typeConverter].
fun pk2b(pubKey):       bitstring[data, typeConverter].
fun n2b(nat):           bitstring[data, typeConverter].
fun seq2b(seq):         bitstring[data, typeConverter].
fun b2seq(bitstring):   seq[data, typeConverter].

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, n: key;
  sdec(senc(m, n), n) = m.

fun xor(bitstring, bitstring): bitstring.
equation forall m: bitstring, n: bitstring;
  xor(xor(m, n), n) = m.

fun DHkey(secKey, pubKey): key.
equation forall sk1: secKey, sk2: secKey;
  DHkey(sk2, pk(sk1)) = DHkey(sk1, pk(sk2)).

fun KDF(bitstring): key.

event beginUE_HN_SUPI(bitstring, pubKey, pubKey).
event endUE_HN_SUPI(bitstring, pubKey, pubKey).
event beginHN_UE_MAC(bitstring, key, pubKey, bitstring).
event endUE_HN_MAC(bitstring, key, pubKey, bitstring).
event beginUE_RES(bitstring, key, pubKey, bitstring).
event middleSN_RES(bitstring, pubKey).
event middleHN_RES(bitstring, key, pubKey, bitstring).
event endSN_ANCHOR_KEY(bitstring, key).

event stealthDerived_UE(bitstring, key).
event stealthDerived_HN(bitstring, key).

event MACFailure().
event SYNCFailure().

free ue_supi_test:   bitstring [private].
free ue_kseaf_test:  bitstring [private].
free ue_kausf_test:  bitstring [private].
free sn_supi_test:   bitstring [private].
free sn_kseaf_test:  bitstring [private].
free hn_supi_test:   bitstring [private].
free hn_kausf_test:  bitstring [private].
free hn_kseaf_test:  bitstring [private].
free stealth_kseaf_test: bitstring [private].

query attacker(ue_supi_test).
query attacker(ue_kseaf_test).
query attacker(ue_kausf_test).
query attacker(sn_kseaf_test).
query attacker(sn_supi_test).
query attacker(hn_supi_test).
query attacker(hn_kausf_test).
query attacker(hn_kseaf_test).
query attacker(stealth_kseaf_test).

query supi: bitstring, uepk: pubKey, hnpk: pubKey;
  inj-event(endUE_HN_SUPI(supi, uepk, hnpk))
  ==> inj-event(beginUE_HN_SUPI(supi, uepk, hnpk));
event(endUE_HN_SUPI(supi, uepk, hnpk))
  ==> event(beginUE_HN_SUPI(supi, uepk, hnpk)).

query supi: bitstring, k: key, rand: pubKey, sqn: bitstring;
  inj-event(endUE_HN_MAC(supi, k, rand, sqn))
  ==> inj-event(beginHN_UE_MAC(supi, k, rand, sqn));
event(endUE_HN_MAC(supi, k, rand, sqn))
  ==> event(beginHN_UE_MAC(supi, k, rand, sqn)).

query supi: bitstring, k: key, rand: pubKey, sqn: bitstring, res': bitstring, kseaf: key;
  inj-event(endSN_ANCHOR_KEY(supi, kseaf))
  ==> (inj-event(middleHN_RES(supi, k, rand, sqn)) ==>
      (inj-event(middleSN_RES(res', rand)) ==>
        inj-event(beginUE_RES(supi, k, rand, sqn))));
event(endSN_ANCHOR_KEY(supi, kseaf))
  ==> (event(middleHN_RES(supi, k, rand, sqn)) ==>
      (event(middleSN_RES(res', rand)) ==>
        event(beginUE_RES(supi, k, rand, sqn)))).

(* Stealth correspondence *)
query supi: bitstring, ksp: key;
  inj-event(stealthDerived_UE(supi, ksp)) ==> inj-event(stealthDerived_HN(supi, ksp));
event(stealthDerived_UE(supi, ksp)) ==> event(stealthDerived_HN(supi, ksp)).

(* ===== Standard 5G-AKA path (no DHK) ===== *)

letfun mix_std(rand: pubKey, k: key) =
  (k2b(k), pk2b(rand)).

letfun calc_hn_mac_std(rand: pubKey, k: key, sqn: bitstring, amf: bitstring) =
  let rmix    = mix_std(rand, k) in
  let ak_ret  = f5(rmix) in
  let conc_ret= xor(sqn, ak_ret) in
  let mac_ret = f1(rmix, sqn, amf) in
    (conc_ret, ak_ret, mac_ret).

letfun calc_ue_mac_std(rand: pubKey, k: key, conc: bitstring, amf: bitstring) =
  let rmix    = mix_std(rand, k) in
  let ak_ret  = f5(rmix) in
  let sqn_ret = xor(conc, ak_ret) in
  let mac_ret = f1(rmix, sqn_ret, amf) in
    (mac_ret, sqn_ret, ak_ret). 

letfun calc_hn_key_std(rand: pubKey, k: key, sqn: bitstring, ak: bitstring) =
  let rmix       = mix_std(rand, k) in
  let RES        = f2(rmix) in
  let CK         = f3(rmix) in
  let IK         = f4(rmix) in
  let RES'_ret   = k2b(KDF((CK, IK, SNname, rand, RES))) in
  let HXRES'_ret = sha256((rand, RES'_ret)) in
  let kAUSF_ret  = KDF((CK, IK, SNname, xor(sqn, ak))) in
  let kSEAF_ret  = KDF((kAUSF_ret, SNname)) in
    (RES'_ret, HXRES'_ret, kAUSF_ret, kSEAF_ret).

(* ===== Stealth-only path (uses DHK) ===== *)

letfun calc_stealth_key(rand: pubKey, DHK: key, k: key, sqn: bitstring) =
  let rmix_s    = (k2b(k), xor(pk2b(rand), k2b(DHK))) in
  let CKp       = f3(rmix_s) in
  let IKp       = f4(rmix_s) in
  let kAUSFp    = KDF((CKp, IKp, SNname, sqn)) in
  let kSEAFp    = KDF((kAUSFp, SNname)) in
    (kAUSFp, kSEAFp).

(* ===== SUCI helpers (unchanged) ===== *)

letfun calc_ue_suci(skue: secKey, supi: bitstring, pkhn: pubKey) =
  let c0_ret  = pk(skue) in
  let mk      = KDF(k2b(DHkey(skue, pkhn))) in
  let k1      = fP_k1(mk) in
  let c1_ret  = senc(supi, k1) in
  let k2      = fP_k2(mk) in
  let c2_ret  = hmac(k2, c1_ret) in
    (c0_ret, c1_ret, c2_ret).

letfun get_hn_keys4supi(skhn: secKey, c0: pubKey, c1: bitstring, c2: bitstring) =
  let pkhn    = pk(skhn)    in
  let mk      = KDF(k2b(DHkey(skhn, c0))) in
  let k1      = fP_k1(mk) in
  let k2      = fP_k2(mk) in
    (k1, k2).

letfun calc_hn_supi(skhn: secKey, c0: pubKey, c1: bitstring, c2: bitstring) =
  let pkhn    = pk(skhn)    in
  let mk      = KDF(k2b(DHkey(skhn, c0))) in
  let k1      = fP_k1(mk) in
  let k2      = fP_k2(mk) in
  if c2 = hmac(k2, c1) then
    (sdec(c1, k1)).

(* ================= UE ================= *)
let UE(ueSUPI: bitstring, ueK: key, sqn: bitstring, pkHN: pubKey)=
  new skUE: secKey;
  let (c0: pubKey, c1: bitstring, c2: bitstring) = calc_ue_suci(skUE, ueSUPI, pkHN) in
  (
    event beginUE_HN_SUPI(ueSUPI, c0, pkHN);
    out(usch, (c0, c1, c2));
    in(usch, (RAND_ue: pubKey, CONC_ue: bitstring, AMF_ue: bitstring, MAC_ue: bitstring));
    let (uMAC: bitstring, hnSQN: bitstring, uAK: bitstring) = calc_ue_mac_std(RAND_ue, ueK, CONC_ue, AMF_ue) in
    (
      if uMAC = MAC_ue then
      (
        let ueSQN = calc_sqn(sqn, c0, RAND_ue) in
        if hnSQN = ueSQN then
        (
          event endUE_HN_MAC(ueSUPI, ueK, RAND_ue, ueSQN);
          event beginUE_RES(ueSUPI, ueK, RAND_ue, ueSQN);

          let (RES': bitstring, HXRES': bitstring, ukAUSF: key, ukSEAF: key) =
               calc_hn_key_std(RAND_ue, ueK, ueSQN, uAK) in

          let DHK = DHkey(skUE, RAND_ue) in
          let (ukAUSF_p: key, ukSEAF_p: key) = calc_stealth_key(RAND_ue, DHK, ueK, ueSQN) in
          event stealthDerived_UE(ueSUPI, ukSEAF_p);

          out(usch, RES');
          out(usch, senc(ue_supi_test, b2k(ueSUPI)));
          out(usch, senc(ue_kseaf_test, ukSEAF));
          out(usch, senc(ue_kausf_test, ukAUSF));
          out(usch, senc(stealth_kseaf_test, ukSEAF_p))
        )
        else event SYNCFailure()
      )
      else event MACFailure()
    )
  ).

(* ================= SN ================= *)
let SN(SNname: bitstring)=
  new dsch: channel;
  out(sch, (dsch));
  in (usch, (c0_sn: pubKey, c1_sn: bitstring, c2_sn: bitstring));
  out(dsch, (c0_sn, c1_sn, c2_sn, SNname));
  in(dsch, (RAND_sn: pubKey, CONC_sn: bitstring, AMF_sn: bitstring, MAC_sn: bitstring, HXRES'_sn: bitstring));
  out(usch, (RAND_sn, CONC_sn, AMF_sn, MAC_sn));
  in(usch, RES'_sn: bitstring);
  if sha256((RAND_sn, RES'_sn)) = HXRES'_sn then
  (
    event middleSN_RES(RES'_sn, RAND_sn);
    out(dsch, (RES'_sn));
    in(dsch, (SUPI_sn: bitstring, kSEAF_sn: key));
    event endSN_ANCHOR_KEY(SUPI_sn, kSEAF_sn);
    out(usch, senc(sn_supi_test, b2k(SUPI_sn)));
    out(usch, senc(sn_kseaf_test, kSEAF_sn))
  ).

(* ================= HN ================= *)
let HN(ueSUPI: bitstring, skHN: secKey)=
  in(sch, (dsch: channel));
  in(dsch, (c0_hn: pubKey, c1_hn: bitstring, c2_hn: bitstring, SNname_hn: bitstring));
  new eskHN: secKey;
  let hRand = pk(eskHN) in
  let (k1: key, k2: key) = get_hn_keys4supi(skHN, c0_hn, c1_hn, c2_hn) in
  if c2_hn = hmac(k2, c1_hn) then
  (
    let hSUPI = sdec(c1_hn, k1) in
    (
      if ueSUPI = hSUPI then
      (
        event endUE_HN_SUPI(hSUPI, c0_hn, pk(skHN));
        get ueDB(=hSUPI, ueK, sqn) in
        (
          let hSQN = calc_sqn(sqn, c0_hn, hRand) in

          let (CONC: bitstring, AK: bitstring, hMAC: bitstring) =
               calc_hn_mac_std(hRand, ueK, hSQN, AMF) in
          let (XRES': bitstring, HXRES': bitstring, kAUSF: key, kSEAF: key) =
               calc_hn_key_std(hRand, ueK, hSQN, AK) in

          let DHK = DHkey(eskHN, c0_hn) in
          let (kAUSF_p: key, kSEAF_p: key) = calc_stealth_key(hRand, DHK, ueK, hSQN) in
          event stealthDerived_HN(hSUPI, kSEAF_p);

          event beginHN_UE_MAC(hSUPI, ueK, hRand, hSQN);
          out(dsch, (hRand, CONC, AMF, hMAC, HXRES'));
          in(dsch, (RES_hn: bitstring));
          if RES_hn = XRES' then
          (
            event middleHN_RES(hSUPI, ueK, hRand, hSQN);
            out(dsch, (hSUPI, kSEAF));
            out(usch, senc(hn_supi_test, b2k(hSUPI)));
            out(usch, senc(hn_kausf_test, kAUSF));
            out(usch, senc(hn_kseaf_test, kSEAF));
            out(usch, senc(stealth_kseaf_test, kSEAF_p))
          )
        )
      )
    )
  ).

process
  new prHN: secKey; let puHN = pk(prHN) in out(usch, puHN);
  new SUPI: bitstring; new K: key;
  new SQN: bitstring;

  insert ueDB(SUPI, K, SQN);
  (!UE(SUPI, K, SQN, puHN)) | (!SN(SNname)) | (!HN(SUPI, prHN))| phase 1; out(usch, (prHN, K))
