

set ignoreTypes = false.

type pubKey.
type secKey.
type key.

free radio: channel.
free core: channel [private].

const AMF: bitstring.
const SNN: bitstring.
const label_xwing: bitstring.
const label_suci: bitstring.
const label_phk: bitstring.
const label_res_star: bitstring.
const label_kausf: bitstring.
const label_kseaf: bitstring.

free SUPI: bitstring [private].
free K: key [private].
free SQN: bitstring [private].
table ueDB(bitstring, key, bitstring).

fun pk(secKey): pubKey.
fun pk2b(pubKey): bitstring [data, typeConverter].
fun k2b(key): bitstring [data, typeConverter].

fun enc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; dec(enc(m,k),k) = m.

fun mac(key, bitstring): bitstring.
fun sha3_256(bitstring): bitstring.
fun xor(bitstring, bitstring): bitstring.
equation forall x: bitstring, y: bitstring; xor(xor(x,y),y) = x.

fun KDF(bitstring): key.
fun key1(key): key.
fun key2(key): key.

fun hnReceipt(bitstring, bitstring, bitstring): bitstring [private].
fun snComplete(bitstring): bitstring [private].

fun f1(key, bitstring): bitstring.
fun f2(key, bitstring): bitstring.
fun f3(key, bitstring): key.
fun f4(key, bitstring): key.
fun f5(key, bitstring): bitstring.

fun kem_ct(bitstring, pubKey): bitstring.
reduc forall ss: bitstring, sk_pq: secKey;
  kem_dec(kem_ct(ss,pk(sk_pq)),sk_pq) = ss.

fun DH(secKey, pubKey): bitstring.
equation forall x: secKey, y: secKey;
  DH(x,pk(y)) = DH(y,pk(x)).

fun XWingCombine(bitstring, bitstring, bitstring, pubKey, pubKey, pubKey, bitstring): bitstring.

free marker_phk_ue: bitstring [private].
free marker_phk_hn: bitstring [private].
free marker_kseaf_ue: bitstring [private].
free marker_kseaf_sn: bitstring [private].
free marker_kseaf_hn: bitstring [private].
free marker_kausf_ue: bitstring [private].
free marker_kausf_hn: bitstring [private].

query attacker(SUPI).
query attacker(marker_phk_ue).
query attacker(marker_phk_hn).
query attacker(marker_kseaf_ue).
query attacker(marker_kseaf_sn).
query attacker(marker_kseaf_hn).
query attacker(marker_kausf_ue).
query attacker(marker_kausf_hn).

free reach_ue: bitstring [private].
free reach_sn: bitstring [private].
free reach_hn: bitstring [private].
query attacker(reach_ue).
query attacker(reach_sn).
query attacker(reach_hn).

event begin_suci(bitstring, bitstring, pubKey, pubKey).
event accept_suci(bitstring, bitstring, pubKey, pubKey).
event send_autn(bitstring, key, bitstring, bitstring, key).
event accept_autn(bitstring, key, bitstring, bitstring, key).
event send_res_ue(bitstring, bitstring, bitstring).
event verify_res_sn(bitstring, bitstring, bitstring).
event accept_res_hn(bitstring, bitstring, bitstring).
event accept_anchor_sn(bitstring, bitstring, bitstring, bitstring).

query supi: bitstring, c0: bitstring, pkhpq: pubKey, pkhdh: pubKey;
  inj-event(accept_suci(supi,c0,pkhpq,pkhdh))
  ==> inj-event(begin_suci(supi,c0,pkhpq,pkhdh));
  event(accept_suci(supi,c0,pkhpq,pkhdh))
  ==> event(begin_suci(supi,c0,pkhpq,pkhdh)).

query supi: bitstring, k: key, rand: bitstring, sqn: bitstring, phk: key;
  inj-event(accept_autn(supi,k,rand,sqn,phk))
  ==> inj-event(send_autn(supi,k,rand,sqn,phk));
  event(accept_autn(supi,k,rand,sqn,phk))
  ==> event(send_autn(supi,k,rand,sqn,phk)).

query supi: bitstring, snn: bitstring, rand: bitstring, resstar: bitstring;
  inj-event(accept_anchor_sn(supi,snn,rand,resstar))
  ==> inj-event(accept_res_hn(supi,rand,resstar));
  inj-event(accept_anchor_sn(supi,snn,rand,resstar))
  ==> inj-event(verify_res_sn(snn,rand,resstar));
  inj-event(accept_anchor_sn(supi,snn,rand,resstar))
  ==> inj-event(send_res_ue(supi,rand,resstar)).

letfun derive_aka(k: key, snn: bitstring, rand: bitstring,
                  phk: key, sqn: bitstring) =
  let common = (rand,k2b(phk)) in
  let ak = f5(k,common) in
  let conc = xor(sqn,ak) in
  let autn_mac = f1(k,(sqn,AMF,rand,k2b(phk))) in
  let res = f2(k,common) in
  let ck = f3(k,common) in
  let ik = f4(k,common) in
  let res_star = k2b(KDF((label_res_star,k2b(ck),k2b(ik),snn,rand,res))) in
  let hxres_star = sha3_256((rand,res_star)) in
  let kausf = KDF((label_kausf,k2b(ck),k2b(ik),snn,conc,k2b(phk))) in
  let kseaf = KDF((label_kseaf,k2b(kausf),snn)) in
  (conc,autn_mac,res_star,hxres_star,kausf,kseaf).

let UE(pkh_pq: pubKey, pkh_dh: pubKey) =

  new sku_pq: secKey;
  new sku_dh: secKey;
  let pku_pq = pk(sku_pq) in
  let pku_dh = pk(sku_dh) in
  new ssue_pq: bitstring;
  let ctue_pq = kem_ct(ssue_pq,pkh_pq) in
  let ctue_dh = pku_dh in
  let ssue_dh = DH(sku_dh,pkh_dh) in
  let ssue = XWingCombine(ssue_pq,ssue_dh,ctue_pq,ctue_dh,pkh_pq,pkh_dh,label_xwing) in
  let kue = KDF((label_suci,ssue)) in
  let k1 = key1(kue) in
  let k2 = key2(kue) in
  let c0 = (ctue_pq,ctue_dh) in
  let c1 = enc((SUPI,pku_pq),k1) in
  let c2 = mac(k2,c1) in
  event begin_suci(SUPI,c0,pkh_pq,pkh_dh);
  out(radio,(c0,c1,c2));

  in(radio,((cthn_pq: bitstring,cthn_dh: pubKey),
            conc_u: bitstring,amf_u: bitstring,mac_u: bitstring));
  if amf_u = AMF then
  let sshn_pq = kem_dec(cthn_pq,sku_pq) in
  let sshn_dh = DH(sku_dh,cthn_dh) in
  let sshn = XWingCombine(sshn_pq,sshn_dh,cthn_pq,cthn_dh,pku_pq,pku_dh,label_xwing) in
  let phk_u = KDF((label_phk,ssue,sshn)) in
  let rand_u = (cthn_pq,cthn_dh) in
  let sqn_hn = xor(conc_u,f5(K,(rand_u,k2b(phk_u)))) in
  if sqn_hn = SQN then
  if mac_u = f1(K,(sqn_hn,AMF,rand_u,k2b(phk_u))) then
  event accept_autn(SUPI,K,rand_u,sqn_hn,phk_u);
  let (conc_check: bitstring,mac_check: bitstring,res_u: bitstring,
       hxres_u: bitstring,kausf_u: key,kseaf_u: key)
      = derive_aka(K,SNN,rand_u,phk_u,sqn_hn) in
  if conc_check = conc_u then
  if mac_check = mac_u then
  event send_res_ue(SUPI,rand_u,res_u);
  out(radio,enc(marker_phk_ue,phk_u));
  out(radio,enc(marker_kausf_ue,kausf_u));
  out(radio,enc(marker_kseaf_ue,kseaf_u));
  out(radio,res_u);
  out(radio,reach_ue).

let SN(snn: bitstring) =

  new sid: bitstring;

  in(radio,(c0_s: bitstring,c1_s: bitstring,c2_s: bitstring));
  out(core,(sid,c0_s,c1_s,c2_s,snn));
  in(core,(=sid,rand_s: bitstring,conc_s: bitstring,amf_s: bitstring,
          mac_s: bitstring,hxres_s: bitstring));
  out(radio,(rand_s,conc_s,amf_s,mac_s));

  in(radio,res_s: bitstring);
  if sha3_256((rand_s,res_s)) = hxres_s then
  event verify_res_sn(snn,rand_s,res_s);
  out(core,(sid,res_s));
  in(core,(=sid,supi_s: bitstring,kseaf_s: key,receipt_s: bitstring));
  if receipt_s = hnReceipt(supi_s,rand_s,res_s) then
  event accept_anchor_sn(supi_s,snn,rand_s,res_s);
  out(radio,enc(marker_kseaf_sn,kseaf_s));
  out(radio,reach_sn);
  out(core,(sid,snComplete(sid))).

let HN(skh_pq: secKey, skh_dh: secKey) =

  in(core,(sid_h: bitstring,(ctue_pq: bitstring,ctue_dh: pubKey),c1_h: bitstring,
          c2_h: bitstring,snn_h: bitstring));
  let pkh_pq = pk(skh_pq) in
  let pkh_dh = pk(skh_dh) in
  let ssue_pq = kem_dec(ctue_pq,skh_pq) in
  let ssue_dh = DH(skh_dh,ctue_dh) in
  let ssue = XWingCombine(ssue_pq,ssue_dh,ctue_pq,ctue_dh,pkh_pq,pkh_dh,label_xwing) in
  let kue = KDF((label_suci,ssue)) in
  let k1 = key1(kue) in
  let k2 = key2(kue) in
  if c2_h = mac(k2,c1_h) then
  let (supi_h: bitstring,pku_pq: pubKey) = dec(c1_h,k1) in
  if supi_h = SUPI then
  let pku_dh = ctue_dh in
  let c0_h = (ctue_pq,ctue_dh) in
  event accept_suci(supi_h,c0_h,pkh_pq,pkh_dh);

  new sshn_pq: bitstring;
  new eskh_dh: secKey;
  let cthn_pq = kem_ct(sshn_pq,pku_pq) in
  let cthn_dh = pk(eskh_dh) in
  let sshn_dh = DH(eskh_dh,pku_dh) in
  out(radio,sshn_dh); 
  let sshn = XWingCombine(sshn_pq,sshn_dh,cthn_pq,cthn_dh,pku_pq,pku_dh,label_xwing) in
  let rand_h = (cthn_pq,cthn_dh) in
  let phk_h = KDF((label_phk,ssue,sshn)) in
  get ueDB(=supi_h,k_h,sqn_h) in
  let (conc_h: bitstring,mac_h: bitstring,xres_h: bitstring,
       hxres_h: bitstring,kausf_h: key,kseaf_h: key)
      = derive_aka(k_h,snn_h,rand_h,phk_h,sqn_h) in
  event send_autn(supi_h,k_h,rand_h,sqn_h,phk_h);
  out(core,(sid_h,rand_h,conc_h,AMF,mac_h,hxres_h));

  in(core,(=sid_h,res_h: bitstring));
  if res_h = xres_h then
  event accept_res_hn(supi_h,rand_h,res_h);
  out(radio,enc(marker_phk_hn,phk_h));
  out(radio,enc(marker_kausf_hn,kausf_h));
  out(radio,enc(marker_kseaf_hn,kseaf_h));
  out(radio,reach_hn);
  out(core,(sid_h,supi_h,kseaf_h,hnReceipt(supi_h,rand_h,res_h)));
  in(core,(=sid_h,done_h: bitstring));
  if done_h = snComplete(sid_h) then
  phase 1;
  out(radio,(skh_pq,skh_dh,K)).

process
  new skh_pq: secKey;
  new skh_dh: secKey;
  let pkh_pq = pk(skh_pq) in
  let pkh_dh = pk(skh_dh) in
  out(radio,(pkh_pq,pkh_dh));
  insert ueDB(SUPI,K,SQN);
  ((!UE(pkh_pq,pkh_dh)) | (!SN(SNN)) | (!HN(skh_pq,skh_dh)))
